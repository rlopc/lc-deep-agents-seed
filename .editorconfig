# Editor-level rules, applied before any formatter runs. They restate in a
# tool-agnostic file what other configuration enforces elsewhere — .gitattributes
# in Git, ruff in Python — so editors that read neither still get it right.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,md}]
indent_size = 2

[*.md]
# Markdown encodes a hard line break as two trailing spaces; trimming breaks it.
trim_trailing_whitespace = false

[*.py]
# Mirrors ruff's line-length, so the editor shows the limit that CI enforces.
# Only Python: no tool checks line length in Markdown or YAML, and Markdown
# holds long URLs and tables that should not be flagged.
max_line_length = 88
