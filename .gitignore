# Secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# Editor autosave files (can mirror .env and leak secrets)
\#*\#
.#*
*~

# Byte-compiled files
__pycache__/
*.py[cod]

# Packaging artefacts
build/
dist/
*.egg-info/

# Virtual environment
.venv/

# Test and coverage artefacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Tool caches
.mypy_cache/
.ruff_cache/

# Local state written by `langgraph dev`
.langgraph_api/

# Claude Code: shared config is committed, personal overrides are not
.claude/settings.local.json

# VS Code: same split. A global ignore rule usually excludes .vscode/ outright, and
# Git will not descend into an excluded directory, so it has to be re-included before
# the two shared files can be listed.
!.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
